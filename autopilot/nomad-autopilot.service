[Unit]
Description=NOMAD autopilot supervisor (keeps agent workers on each project's board)
After=network-online.target
# The supervisor exits rather than serve without its token, and exits 3 after 5 loop failures in
# a row. These limits land it in `failed`, which nomad-watch and `systemctl --user status` show.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# The code runs from a deploy worktree detached at master (#1012), never from ~/nomad: other
# sessions keep that shared checkout on their own branches. scripts/autopilot-deploy.sh moves it.
# Projects, .env, tokens and state are still read from ~/nomad and ~/.config, ~/.local/state.
WorkingDirectory=%h/nomad-wt/autopilot-live
Environment=NOMAD_ENV_FILE=%h/nomad/.env
Environment=PYTHONUNBUFFERED=1
# ~/.local/bin first: workers run `claude` (native installer, #861) and the test wrappers use uv.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Claude runs on the MAX account through Claude Code, never the API.
Environment=ANTHROPIC_API_KEY=
# Also listen on the Docker bridge gateway: the engine reaches it there under Docker Engine (#383).
Environment=NOMAD_BRIDGE_IP=172.17.0.1
ExecStart=%h/.local/bin/uv run --no-project --with pyyaml --with requests python autopilot/supervisor.py
Restart=on-failure
RestartSec=30
# Workers, gates and criteria drafts run in their own sessions, and crash recovery adopts live
# workers after a restart (AC8). The default KillMode=control-group would kill them on every
# stop or restart; `process` signals the supervisor only. Stop a project's workers with
# Stop (kill) in the cockpit, not with systemctl.
KillMode=process

[Install]
WantedBy=default.target
