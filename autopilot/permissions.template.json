{
  "_about": [
    "Shared permission template for autopilot workers (PRD docs/prd/autopilot.md 5.8, task #875).",
    "DRAFT for operator review in #876. autopilot/permissions.py renders it per worker: it fills",
    "the placeholders, adds the project's wrapper commands, its deny_edit_globs and",
    "additionalDirectories, and drops every key starting with '_'. See README-permissions.md.",
    "Placeholders: {worktree} the task worktree, {repo} the main checkout, {state_dir} the",
    "autopilot state folder (settings files and wrappers). All are absolute paths, so",
    "'Edit(/{worktree}/**)' renders as 'Edit(//abs/path/**)', Claude Code's absolute form.",
    "Rules: 'Bash(x *)' matches 'x' and 'x <anything>' (the space is a word boundary).",
    "Edit(...) rules cover Edit, Write, MultiEdit and NotebookEdit; Write(...) rules are ignored",
    "by Claude Code, so there are none here. Deny always beats allow, from any settings source."
  ],
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "mcp__nomad-pm",

      "Edit(/{worktree}/**)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git worktree list *)",

      "Bash(git -C {worktree} status *)",
      "Bash(git -C {worktree} diff *)",
      "Bash(git -C {worktree} log *)",
      "Bash(git -C {worktree} show *)",
      "Bash(git -C {worktree} rev-parse *)",
      "Bash(git -C {worktree} add *)",
      "Bash(git -C {worktree} commit *)",
      "Bash(git -C {worktree} switch *)",
      "Bash(git -C {worktree} merge *)",
      "Bash(git -C {worktree} branch)",
      "Bash(git -C {worktree} branch --show-current)",
      "Bash(git -C {worktree} branch --list *)",

      "Bash(git -C {repo} status *)",
      "Bash(git -C {repo} diff *)",
      "Bash(git -C {repo} log *)",
      "Bash(git -C {repo} show *)",
      "Bash(git -C {repo} rev-parse *)",

      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(test *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(pwd *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git commit --amend *)",
      "Bash(git commit * --amend*)",
      "Bash(git worktree remove *)",

      "Bash(git -C {worktree} push *)",
      "Bash(git -C {worktree} stash *)",
      "Bash(git -C {worktree} reset *)",
      "Bash(git -C {worktree} rebase *)",
      "Bash(git -C {worktree} clean *)",
      "Bash(git -C {worktree} branch -D *)",
      "Bash(git -C {worktree} branch -d *)",
      "Bash(git -C {worktree} branch --delete *)",
      "Bash(git -C {worktree} commit --amend *)",
      "Bash(git -C {worktree} commit * --amend*)",
      "Bash(git -C {worktree} switch -f*)",
      "Bash(git -C {worktree} switch --force*)",
      "Bash(git -C {worktree} switch -C *)",
      "Bash(git -C {worktree} switch --discard-changes*)",
      "Bash(git -C {worktree} switch * --discard-changes*)",

      "Bash(git -C {repo} push *)",
      "Bash(git -C {repo} stash *)",
      "Bash(git -C {repo} reset *)",
      "Bash(git -C {repo} rebase *)",
      "Bash(git -C {repo} clean *)",
      "Bash(git -C {repo} checkout *)",
      "Bash(git -C {repo} branch -D *)",
      "Bash(git -C {repo} commit *)",
      "Bash(git -C {repo} merge *)",

      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm --recursive *)",

      "Edit(**/AGENTS.md)",
      "Edit(//**/AGENTS.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(//**/CLAUDE.md)",
      "Edit(**/AUTONOMY.md)",
      "Edit(//**/AUTONOMY.md)",
      "Edit(**/.claude/**)",
      "Edit(//**/.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(**/.mcp.json)",
      "Edit(//**/.mcp.json)",
      "Edit(**/projects.yaml)",
      "Edit(//**/projects.yaml)",
      "Edit(/{repo}/**)",
      "Edit(/{state_dir}/**)"
    ]
  }
}
