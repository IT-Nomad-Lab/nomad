[Unit]
Description=NOMAD local audio generation (ACE-Step on the RTX 5090)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = the user's home. Assumes the repo at ~/nomad; adjust if cloned elsewhere.
WorkingDirectory=%h/nomad/nomad-audio
# Binds 127.0.0.1 (server.py default, #821). The v2 engine container still reaches it via
# host.docker.internal:8220 (Docker Desktop's gateway lands on host loopback).
ExecStart=%h/nomad/nomad-audio/.venv/bin/python %h/nomad/nomad-audio/server.py
Environment=NOMAD_AUDIO_PORT=8220
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
