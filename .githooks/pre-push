#!/usr/bin/env bash
# NOMAD pre-push gate (roadmap T0.3).
#
# pre-commit is the first net, not the last one. git does NOT run pre-commit for
# merge, rebase or cherry-pick, and a local commit is recoverable anyway. The push is
# the irreversible step, so the range being pushed gets scanned here as well.
#
# stdin format, one line per ref: <local ref> <local sha> <remote ref> <remote sha>
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
GL="${GITLEAKS_BIN:-$(command -v gitleaks || echo "$HOME/bin/gitleaks")}"
ZERO="0000000000000000000000000000000000000000"

if [ ! -x "$GL" ]; then
  echo "pre-push: gitleaks not found at '$GL'." >&2
  echo "  The pre-commit gate already scanned each commit as it was made." >&2
  echo "  Install gitleaks (scripts/install-git-hooks.sh prints the command) to scan the" >&2
  echo "  pushed range too. Allowing the push." >&2
  exit 0
fi

rc=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                 # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    RANGE="$local_sha"                                    # new branch: scan its history
  else
    RANGE="${remote_sha}..${local_sha}"
  fi
  REPORT="$(mktemp -t nomad-prepush-XXXXXX.json)"
  "$GL" git "$ROOT" --log-opts "$RANGE" --redact=100 --report-format json \
        --report-path "$REPORT" --exit-code 0 --log-level error >/dev/null 2>&1
  n="$(python3 -c "import json,sys;print(len(json.load(open(sys.argv[1]))))" "$REPORT" 2>/dev/null || echo 0)"
  if [ "${n:-0}" -gt 0 ]; then
    echo "" >&2
    echo "PUSH BLOCKED: $n possible credential(s) in the commits being pushed ($RANGE)." >&2
    echo "values are redacted below; nothing secret was printed or written." >&2
    python3 - "$REPORT" >&2 <<'PY'
import json, sys
for f in json.load(open(sys.argv[1])):
    print("  {}:{}  [{}]  commit {}".format(
        f.get("File"), f.get("StartLine"), f.get("RuleID"), (f.get("Commit") or "")[:12]))
PY
    echo "" >&2
    echo "The secret is already in a commit object. Do NOT just delete the line and" >&2
    echo "re-commit: rewriting history is the operator's call. ROTATE the credential" >&2
    echo "first, then decide on the rewrite." >&2
    rc=1
  fi
  rm -f "$REPORT"
done

exit $rc
