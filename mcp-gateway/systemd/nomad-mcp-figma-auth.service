[Unit]
Description=NOMAD MCP gateway: bearer-token proxy for the figma wrapper
After=nomad-mcp-figma.service
Requires=nomad-mcp-figma.service

[Service]
ExecStart=%h/nomad/mcp-local/.venv/bin/python %h/nomad/mcp-gateway/auth_proxy.py --listen 172.17.0.1:8311 --upstream http://127.0.0.1:18311
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
